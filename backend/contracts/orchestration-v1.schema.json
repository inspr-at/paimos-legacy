{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paimos.dev/contracts/orchestration-v1.schema.json",
  "$ref": "#/$defs/OrchestrationSnapshotV1",
  "$defs": {
    "WorkerFleetSnapshotV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "observed_at",
        "scope",
        "zoom",
        "band",
        "sample_limit",
        "sample_truncated",
        "totals",
        "projects",
        "workers",
        "provenance"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 2
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "project_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "portfolio",
                "project"
              ]
            },
            "project_id": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64"
            }
          }
        },
        "zoom": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,63}$",
          "minLength": 1,
          "maxLength": 64,
          "default": "10"
        },
        "band": {
          "type": "string",
          "enum": [
            "detail",
            "overview",
            "aggregate",
            "far"
          ]
        },
        "sample_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "sample_truncated": {
          "type": "boolean"
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projects",
            "sampled_projects",
            "omitted_projects",
            "workers",
            "sampled_workers",
            "omitted_workers"
          ],
          "properties": {
            "projects": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "sampled_projects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "omitted_projects": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "workers": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            },
            "sampled_workers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "omitted_workers": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        },
        "projects": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "key",
              "name",
              "total_workers",
              "sampled_workers",
              "omitted_workers",
              "orchestrator"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              },
              "key": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "total_workers": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "sampled_workers": {
                "type": "integer",
                "minimum": 0
              },
              "omitted_workers": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "orchestrator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "reason",
                  "session_id"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "resolved",
                      "unset",
                      "ambiguous"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "single_active_coordinator",
                      "no_active_coordinator",
                      "multiple_active_coordinators",
                      "coordinator_unknown"
                    ]
                  },
                  "session_id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "workers": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "harness_session_id",
              "parent_harness_session_id",
              "parent_in_sample",
              "project",
              "agent",
              "role",
              "harness",
              "machine_id",
              "workspace_provenance",
              "dispatch_profile",
              "account_label",
              "management_mode",
              "runtime_provenance_trust",
              "ticket",
              "work_shape",
              "work_contract",
              "phase",
              "revision",
              "liveness",
              "capabilities",
              "recent_communication",
              "recent_communication_omitted",
              "delivery_trust"
            ],
            "properties": {
              "harness_session_id": {
                "type": "string",
                "format": "uuid"
              },
              "parent_harness_session_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "parent_in_sample": {
                "type": "boolean"
              },
              "project": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "key",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  "key": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "agent": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "role": {
                "type": "string",
                "enum": [
                  "coordinator",
                  "worker"
                ]
              },
              "harness": {
                "type": "string"
              },
              "machine_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128,
                "description": "Stable machine label only when runtime_provenance_trust is managed_reporter; otherwise null. Raw host fields are never separately exposed."
              },
              "workspace_provenance": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/WorkerWorkspaceProvenance"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dispatch_profile": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/HarnessDispatchProfile"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "account_label": {
                "type": "string",
                "enum": [
                  "unknown",
                  "chatgpt",
                  "api_key",
                  "claude_ai_max",
                  "claude_ai_pro",
                  "claude_ai_team",
                  "claude_ai_enterprise",
                  "console",
                  "pi_context",
                  "cursor_context"
                ]
              },
              "account_key": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "description": "Opaque named-account selection when runtime_provenance_trust is managed_reporter. Distinct from account_label. Omitted when empty. Never a path, env, executable, or credential."
              },
              "management_mode": {
                "type": "string",
                "enum": [
                  "managed",
                  "unmanaged"
                ]
              },
              "runtime_provenance_trust": {
                "type": "string",
                "enum": [
                  "managed_reporter",
                  "untrusted"
                ],
                "description": "managed_reporter requires managed mode, complete workspace provenance, and a valid lease-authenticated reporter heartbeat. Untrusted rows suppress machine, workspace, dispatch, and account axes."
              },
              "ticket": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "details_available",
                      "key",
                      "title"
                    ],
                    "properties": {
                      "id": {
                        "type": "integer",
                        "format": "int64",
                        "minimum": 1
                      },
                      "details_available": {
                        "type": "boolean"
                      },
                      "key": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "title": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "work_shape": {
                "type": "string",
                "enum": [
                  "unknown",
                  "ship",
                  "scout"
                ],
                "description": "Explicit assignment classification. A null ticket always pairs with unknown; missing legacy storage also projects as unknown and is never inferred."
              },
              "work_contract": {
                "$ref": "#/$defs/WorkShapeContract"
              },
              "phase": {
                "type": "string",
                "enum": [
                  "starting",
                  "working",
                  "yielded",
                  "stopping",
                  "stopped"
                ]
              },
              "revision": {
                "type": "integer",
                "format": "int64",
                "minimum": 1
              },
              "liveness": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "reason",
                  "observed_at",
                  "source",
                  "reporter_age_seconds"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "busy",
                      "idle",
                      "unknown",
                      "dead"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "agentd_reporter",
                      "control_plane",
                      "unmanaged",
                      "unknown"
                    ]
                  },
                  "reporter_age_seconds": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "format": "int64",
                    "minimum": 0
                  },
                  "closed_reason": {
                    "type": "string"
                  }
                }
              },
              "capabilities": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inbox",
                  "status",
                  "steer",
                  "interrupt",
                  "stop"
                ],
                "properties": {
                  "inbox": {
                    "type": "boolean"
                  },
                  "status": {
                    "type": "boolean"
                  },
                  "steer": {
                    "type": "boolean"
                  },
                  "interrupt": {
                    "type": "boolean"
                  },
                  "stop": {
                    "type": "boolean"
                  }
                }
              },
              "recent_communication": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "message_id",
                    "delivery_id",
                    "direction",
                    "attribution",
                    "requested_level",
                    "effective_level",
                    "state",
                    "fallback_code",
                    "error_code",
                    "occurred_at"
                  ],
                  "properties": {
                    "message_id": {
                      "type": "string"
                    },
                    "delivery_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "direction": {
                      "type": "string",
                      "enum": [
                        "incoming",
                        "outgoing"
                      ]
                    },
                    "attribution": {
                      "type": "string",
                      "const": "project_agent"
                    },
                    "requested_level": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "simple",
                        "steer",
                        null
                      ]
                    },
                    "effective_level": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "simple",
                        "steer",
                        null
                      ]
                    },
                    "state": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "fallback_code": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "error_code": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "occurred_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              },
              "recent_communication_omitted": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "delivery_trust": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "progress_trusted",
                  "eta_trusted",
                  "reason",
                  "trust_revision",
                  "observed_at",
                  "progress_percent",
                  "eta"
                ],
                "properties": {
                  "progress_trusted": {
                    "type": "boolean"
                  },
                  "eta_trusted": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "trusted",
                      "ticket_unbound",
                      "trust_unavailable",
                      "trust_malformed",
                      "no_estimate",
                      "terminal_complete",
                      "cancelled",
                      "terminal_failed",
                      "waiting_on_human",
                      "blocked",
                      "stale",
                      "unknown_reporter",
                      "no_signal",
                      "estimate_expired",
                      "outlier_heavy",
                      "insufficient_basis",
                      "missing_contributor"
                    ]
                  },
                  "trust_revision": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "observed_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  },
                  "progress_percent": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  },
                  "eta": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "cache",
            "remote_cache",
            "projection_version",
            "terminal_generations_per_agent"
          ],
          "properties": {
            "source": {
              "type": "string",
              "const": "authoritative_database"
            },
            "cache": {
              "type": "string",
              "const": "none"
            },
            "remote_cache": {
              "type": "boolean",
              "const": false
            },
            "projection_version": {
              "type": "integer",
              "const": 2
            },
            "terminal_generations_per_agent": {
              "type": "integer",
              "const": 1
            }
          }
        }
      }
    },
    "WorkerWorkspaceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mode"
      ],
      "description": "Privacy-safe workspace isolation provenance. Raw paths, workspace identity, and Git branch are deliberately excluded.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "directory",
            "git_primary",
            "git_worktree"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ]
        }
      }
    },
    "HarnessDispatchProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "harness",
        "model",
        "effort",
        "machine_source",
        "account_source",
        "workspace_mode"
      ],
      "description": "Exact immutable profile resolved through the execution-options authority before process spawn.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "harness": {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "pi",
            "cursor"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "default"
          ]
        },
        "machine_source": {
          "type": "string",
          "enum": [
            "authenticated_reporter"
          ]
        },
        "account_source": {
          "type": "string",
          "enum": [
            "local_probe"
          ]
        },
        "workspace_mode": {
          "type": "string",
          "enum": [
            "exclusive",
            "shared"
          ]
        }
      }
    },
    "WorkShapeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "output_kind",
        "stage_applicability",
        "definition_of_done",
        "non_goals"
      ],
      "description": "Bounded, value-free assignment defaults. This presentation contract records neither ticket prose nor repository enforcement and never rewrites historical delivery attempts.",
      "properties": {
        "shape": {
          "type": "string",
          "enum": [
            "unknown",
            "ship",
            "scout"
          ]
        },
        "output_kind": {
          "type": "string",
          "enum": [
            "unclassified",
            "delivery",
            "investigation_evidence"
          ]
        },
        "stage_applicability": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "applicability"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "specification",
                  "implementation",
                  "qa",
                  "deployment",
                  "verification"
                ]
              },
              "applicability": {
                "type": "string",
                "enum": [
                  "required",
                  "not_applicable",
                  "unknown"
                ]
              }
            }
          }
        },
        "definition_of_done": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "implementation_complete",
              "required_stages_succeeded",
              "delivery_verified",
              "investigation_question_answered",
              "evidence_recorded",
              "uncertainty_reported",
              "explicit_classification_required"
            ]
          }
        },
        "non_goals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "product_delivery",
              "git_enforcement",
              "silent_promotion",
              "delivery_claim",
              "shape_inference"
            ]
          }
        }
      }
    },
    "OrchestrationCoordinatorV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason",
        "session_id"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "resolved",
            "unset",
            "ambiguous"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "single_active_coordinator",
            "no_active_coordinator",
            "multiple_active_coordinators",
            "coordinator_unknown"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "OrchestrationRootV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configured_identity",
        "binding_revision",
        "binding_updated_at",
        "active_generation"
      ],
      "properties": {
        "configured_identity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "display_label"
              ],
              "properties": {
                "display_label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "binding_revision": {
          "type": "integer",
          "minimum": 0
        },
        "binding_updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "active_generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "session_id"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "resolved",
                "unset",
                "ambiguous",
                "unknown"
              ]
            },
            "reason": {
              "type": "string",
              "enum": [
                "root_not_configured",
                "generation_unavailable",
                "no_active_root_generation",
                "multiple_active_root_generations",
                "generation_not_in_sample",
                "root_generation_unknown",
                "single_active_root_generation"
              ]
            },
            "session_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          }
        }
      }
    },
    "ProjectCoordinationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "coordinator",
        "relationship",
        "root_binding_revision"
      ],
      "properties": {
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "key",
            "name"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "key": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "coordinator": {
          "$ref": "#/$defs/OrchestrationCoordinatorV1"
        },
        "relationship": {
          "type": "string",
          "const": "instance_root_coordination"
        },
        "root_binding_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "OrchestrationSnapshotV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "instance_root",
        "fleet",
        "project_coordination",
        "coordination_bounds"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "instance_root": {
          "$ref": "#/$defs/OrchestrationRootV1"
        },
        "fleet": {
          "$ref": "#/$defs/WorkerFleetSnapshotV2"
        },
        "project_coordination": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ProjectCoordinationV1"
          }
        },
        "coordination_bounds": {
          "type": "object",
